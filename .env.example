# Local testing is the default, even when Google credentials are present.
# Local mode uses data\dispatch-local.db and files under storage\.
# Drive mode uses the separate, existing data\dispatch.db.
STORAGE_MODE=local

# ── Google Drive integration (optional) ──────────────────────────────
# These settings are ignored unless STORAGE_MODE=drive.
#
# Option A: point to your downloaded service-account JSON key file
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\path\to\service-account-key.json
#
# Option B: paste the JSON contents directly (single line)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
#
# The ID of the shared Drive folder that holds all driver folders.
# (The long string in the folder's URL: drive.google.com/drive/folders/<THIS>)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
#
# Alternatively, use OAuth with the same root folder setting:
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
