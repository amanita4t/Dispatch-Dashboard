# PostgreSQL is the only runtime database, including local development.
# Keep live production and private-test datasets separate.
# All deployments WRITING to one Drive root must share the SAME PostgreSQL database.
# An independent preview branch sharing that root must use GOOGLE_DRIVE_READ_ONLY=true.
# For independent writable previews, use a separate test Drive root and empty/bound DB;
# cloning a Neon branch does not copy/isolate Drive. Never relabel cloned folder IDs.
# Keep pooled and direct URLs on the SAME branch/database. Never use NEXT_PUBLIC_.
# Runtime connection priority: DATABASE_URL, then POSTGRES_URL.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# Optional direct connection for operator-run schema migration:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# Vercel-compatible alternatives to the two names above:
# POSTGRES_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# CLI connection priority: DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING,
# DATABASE_URL, then POSTGRES_URL. CLI tools load the project's private env.

# Run npm run db:migrate explicitly: applies schema AND configured storage binding.
# Builds, application startup, and request handlers never run migrations.
# A fresh database starts empty. Use Sync Storage to discover existing Drive
# folders and documents; trip details and statuses must be entered separately.

# Local documents are development-only; Vercel rejects STORAGE_MODE=local.
# Local mode uses storage\ for documents but still requires PostgreSQL.
# Its database binding includes the absolute storage\ path for this working directory.
STORAGE_MODE=local

# Google Drive settings are used only with STORAGE_MODE=drive.
# Select the private TEST root, not production, when preparing a private trial.
# Runtime binding rejects a root/mode that does not match this PostgreSQL database.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_private_test_root_folder_id

# Read-only Drive access permits sync/viewing but blocks folder/document changes:
# GOOGLE_DRIVE_READ_ONLY=true

# OAuth: keep the current account/token when moving the same Drive dataset.
# The OAuth helper leaves PostgreSQL connection settings unchanged.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Alternative service-account credentials (private server environment only):
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
# Trusted local development may instead point to a key OUTSIDE the checkout:
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\private-credentials\service-account-key.json

# No application authentication is included. Configure Vercel Deployment Protection
# BEFORE deployment, then verify BOTH production and preview URLs deny public access.
# Standard Protection excludes production domains. All Deployments scope is required;
# select a supported protection method/plan and verify actual unauthenticated access.
# Do not connect real dispatch data until both are verified private.
# If both URL types cannot be protected, leave the project undeployed.
