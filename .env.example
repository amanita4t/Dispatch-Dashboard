# ── Google Drive integration (optional) ──────────────────────────────
# When these are set, files & folders are created in Google Drive.
# When empty, everything is stored locally under ./storage/
#
# Option A: point to your downloaded service-account JSON key file
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=C:\path\to\service-account-key.json
#
# Option B: paste the JSON contents directly (single line)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}
#
# The ID of the shared Drive folder that holds all driver folders.
# (The long string in the folder's URL: drive.google.com/drive/folders/<THIS>)
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
